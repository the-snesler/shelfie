# TMDB API Read Access Token - used for searching movies and TV via TMDB.
# the long Bearer token, not the short v3 API key
# (https://www.themoviedb.org/settings/api).
TMDB_TOKEN=your-tmdb-read-access-token

# Twitch developer app credentials - used for searching games via IGDB
# (https://dev.twitch.tv/console/apps).
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# SteamGridDB API key (optional) - used for fetching game cover art and logos
# (https://www.steamgriddb.com/profile/preferences/api)
# STEAMGRIDDB_API_KEY=your-steamgriddb-api-key

# Exact browser origin when the client is hosted separately. Empty uses same-origin.
# CORS_ORIGIN=https://shelfie.example.com
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=1
