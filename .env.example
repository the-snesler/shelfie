# Twitch developer app credentials, used to authenticate against IGDB
# (https://dev.twitch.tv/console/apps).
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# TMDB API Read Access Token — the long Bearer token, not the short v3 API key
# (https://www.themoviedb.org/settings/api).
TMDB_TOKEN=your-tmdb-read-access-token
