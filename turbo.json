{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "SERVER_PORT",
    "CLIENT_PORT",
    "PORT",
    "DATA_DIR",
    "DATABASE_URL",
    "STATIC_DIR",
    "IGDB_CLIENT_ID",
    "IGDB_CLIENT_SECRET",
    "TMDB_TOKEN",
    "GOODREADS_APPSYNC_KEY",
    "CORS_ORIGIN",
    "TRUST_PROXY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "lint": {},
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
